{
  "name": "split-cue",
  "version": "1.11.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~57.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.117.2",
    "expo": "~57.0.21",
    "expo-apple-authentication": "^57.0.2",
    "expo-application": "~57.0.3",
    "expo-audio": "~57.0.4",
    "expo-battery": "~57.0.3",
    "expo-build-properties": "~57.0.23",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-haptics": "~57.0.2",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.24",
    "expo-observe": "~57.0.28",
    "expo-router": "~57.0.20",
    "expo-sharing": "~57.0.18",
    "expo-speech": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "expo-task-manager": "~57.0.21",
    "expo-updates": "~57.0.22",
    "expo-web-browser": "^57.0.3",
    "expo-widgets": "~57.0.18",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-ble-plx": "^3.5.1",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-purchases": "^10.11.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "npx cross-env APP_VARIANT=development expo start --scheme pacecue-dev",
    "start:dev-a": "npx cross-env APP_VARIANT=dev-a expo start --scheme pacecue-deva --port 8081",
    "start:dev-b": "npx cross-env APP_VARIANT=dev-b expo start --scheme pacecue-devb --port 8082",
    "start:prod": "expo start",
    "android": "npx cross-env APP_VARIANT=development expo start --android",
    "ios": "npx cross-env APP_VARIANT=development expo start --ios",
    "build:dev": "eas build --profile development",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:dev:android": "eas build --profile development --platform android",
    "build:dev-a": "eas build --profile dev-a",
    "build:dev-a:ios": "eas build --profile dev-a --platform ios",
    "build:dev-a:android": "eas build --profile dev-a --platform android",
    "build:dev-b": "eas build --profile dev-b",
    "build:dev-b:ios": "eas build --profile dev-b --platform ios",
    "build:dev-b:android": "eas build --profile dev-b --platform android",
    "build:preview": "eas build --profile preview",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:preview-a": "eas build --profile preview-a",
    "build:preview-a:ios": "eas build --profile preview-a --platform ios",
    "build:preview-a:android": "eas build --profile preview-a --platform android",
    "build:preview-b": "eas build --profile preview-b",
    "build:preview-b:ios": "eas build --profile preview-b --platform ios",
    "build:preview-b:android": "eas build --profile preview-b --platform android",
    "build:prod": "eas build --profile production",
    "build:prod:ios": "eas build --profile production --platform ios",
    "build:prod:android": "eas build --profile production --platform android",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android",
    "update:preview": "npx cross-env APP_VARIANT=preview eas update --branch preview --environment preview --upload-source-maps --message",
    "update:preview:sentry": "npx sentry-expo-upload-sourcemaps dist",
    "update:prod": "eas update --branch production --environment production --upload-source-maps --message",
    "update:prod:sentry": "npx sentry-expo-upload-sourcemaps dist",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "private": true
}
