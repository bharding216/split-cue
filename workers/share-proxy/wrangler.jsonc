{
  "name": "splitcue-share",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "splitcue.app/*", "zone_name": "splitcue.app" }
  ],
  "vars": {
