{
  "cli": {
    "version": ">= 24.9.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "uploadSourceMaps": true,
      "env": {
        "APP_VARIANT": "preview"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "uploadSourceMaps": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6809834816"
      }
    }
  }
}
